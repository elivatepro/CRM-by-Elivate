# Local Docker Compose settings only. Railway secrets are configured in Railway.
SERVER_URL=http://localhost:3000
PG_DATABASE_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-random-encryption-key

# Intake forms service.
# Create the key in the CRM under Settings -> APIs & Webhooks -> API keys.
# This key is only ever read server-side; it is never sent to the browser.
TWENTY_API_KEY=replace-with-a-crm-api-key

# Data model names, only needed if your objects are not named like this.
TWENTY_TEAM_OBJECT=teams
TWENTY_TEAM_NAME_FIELD=name
TWENTY_PERSON_OBJECT=people
TWENTY_OPPORTUNITY_OBJECT=opportunities
TWENTY_PICKUP_ORDER_OBJECT=pickupOrders

# Records created through the forms are attributed to this workspace member.
# Find the id under Settings -> Members, or leave blank to attribute to the API key.
TWENTY_RECORD_AUTHOR_ID=
TWENTY_RECORD_AUTHOR_NAME=

# Outgoing member email. Without these the forms still work but send nothing.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Elivate Network
# Optional: copy every member email to these addresses.
EMAIL_BCC=
# How often to check the CRM for newly approved members, in milliseconds.
APPROVAL_POLL_MS=60000
